DATABASE_URL=postgres://postgres:postgres@localhost:5432/go_flow?sslmode=disable
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=8080
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
EXECUTION_PARALLEL=true
# Production container sets GIN_MODE=release and STATIC_DIR=/app/web/dist.
# Only needed for a frontend hosted at a different origin:
# ALLOWED_ORIGINS=https://your-frontend.example
# Optional integrations:
# GEMINI_API_KEY=
# GOOGLE_CREDENTIALS=
